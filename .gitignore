cat > .gitignore << 'EOF'
# Gradle / build
.gradle/
build/
**/build/

# Local config
local.properties

# Android Studio / IntelliJ
.idea/
*.iml

# Captures / native
captures/
.externalNativeBuild/
.cxx/

# Keystore / secrets
*.jks
*.keystore
google-services.json

# OS files
.DS_Store
Thumbs.db

# APK / AAB artifacts
*.apk
*.aab

# Misc
*.log
EOF
