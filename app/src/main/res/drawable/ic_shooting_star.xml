<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fire Tail -->
    <item>
        <rotate
            android:fromDegrees="-135" 
            android:pivotX="100%"
            android:pivotY="50%">
